// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  Pending
  In_Progress
  Completed
}

enum Priority {
  Low
  High
  Medium
  Urgent
}

model Project {
  id          String   @id @default(uuid())
  title       String
  code        String
  description String
  status      Status
  priority    Priority
  dueDate     DateTime
  issues      Issue[]
}

model Issue {
  id          String   @id @default(uuid())
  title       String
  description String
  status      Status
  priority    Priority
  dueDate     DateTime
  projectId   String
  createdFor  Project  @relation(fields: [projectId], references: [id])
}

model USER {
  id           String @id @default(uuid())
  name         String
  email        String  @unique
  passwordHash String
}
